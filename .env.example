# Firebase Configuration (Replace with your Firebase Project hackerthon-2f7b1 web app credentials)
# In Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=hackerthon-2f7b1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hackerthon-2f7b1
VITE_FIREBASE_STORAGE_BUCKET=hackerthon-2f7b1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=208169344350
VITE_FIREBASE_APP_ID=1:208169344350:web:exampleappid

# Firebase App Check Configuration
# For local development: Set to 'true' to auto-generate a debug token in the browser console,
# or set to a registered debug token string from Firebase Console -> App Check -> Apps -> Debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=true
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_optional

# Routing Configuration
VITE_ROUTING_LENGTH_THRESHOLD=1200
